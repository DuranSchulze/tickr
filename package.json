{
  "name": "trackly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "check-all": "pnpm typecheck && pnpm lint && pnpm test",
    "email:test-templates": "tsx src/lib/server/email-templates/send-test-emails.ts",
    "post-cta-init": "npx -y create-db@latest --user-agent tanstack/tsrouter",
    "db:health": "curl -sS http://localhost:3000/api/health",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx src/db/seed.ts",
    "db:backfill-entry-source": "dotenv -e .env.local -- tsx scripts/backfill-time-entry-source.ts",
    "db:backfill-entry-source:apply": "dotenv -e .env.local -- tsx scripts/backfill-time-entry-source.ts --apply",
    "prepare": "husky || true",
    "doctor": "npx react-doctor@latest",
    "extension:dev": "echo 'Extension is ready at extension/ — edit config.js and load unpacked in chrome://extensions'",
    "extension:build": "./extension/build.sh",
    "extension:build:prod": "APP_URL=https://tickr-nu.vercel.app ./extension/build.sh",
    "extension:zip": "./extension/build.sh"
  },
  "dependencies": {
    "@better-auth/infra": "^0.2.3",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/nunito": "^5.2.7",
    "@fontsource-variable/roboto": "^5.2.10",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@imagekit/react": "^5.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/react": "^10.53.1",
    "@sentry/tanstackstart-react": "^10.53.1",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.6.18",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "goey-toast": "^0.4.0",
    "jose": "^6.2.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "liquid-gooey": "^0.1.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.5.0",
    "motion": "^12.40.0",
    "nodemailer": "^8.0.11",
    "ogl": "^1.0.11",
    "pg": "^8.20.0",
    "postprocessing": "^6.39.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-confetti": "^6.4.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.180.0",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2",
    "web-vitals": "^5.3.0",
    "youch": "^4.1.1",
    "youch-core": "^0.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "nitro": "3.0.260415-beta",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "react-doctor": "^0.9.12",
    "react-grab": "^0.1.50",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^3.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
