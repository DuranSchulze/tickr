
DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Dedicated signing secret for public-API JWTs (/api/v1/*). Required in every
# environment that issues API tokens. Kept separate from BETTER_AUTH_SECRET on
# purpose: sharing one key across session signing and API tokens means rotating
# one invalidates the other, and a single leak compromises both. Changing it
# invalidates all previously issued public-API tokens.
EXTERNAL_API_JWT_SECRET=
# Optional. Token lifetime in seconds; defaults to 3600 (1 hour).
EXTERNAL_API_JWT_TTL_SECONDS=

# Authentication abuse protection (brute-force throttling).
# off | shadow | enforce. "shadow" counts attempts and logs threshold breaches
# but never blocks anyone — use it to tune limits against real traffic before
# enforcing. Defaults to enforce in production and shadow in development.
AUTH_ABUSE_MODE=enforce
# Dedicated HMAC key for hashed abuse-counter identifiers (emails and IPs).
# Use at least 32 random characters. When unset, BETTER_AUTH_SECRET is used
# with domain-separated bucket identifiers. Enforcement fails closed if neither exists.
AUTH_ABUSE_HMAC_SECRET=
# Non-Vercel production only: header overwritten by your trusted ingress proxy.
# Leave unset unless the proxy strips client-supplied copies.
AUTH_TRUSTED_IP_HEADER=

GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

RESEND_API_KEY=
RESEND_FROM=
EMAIL_FROM=
EMAIL_TEMPLATE_TEST_RECIPIENT=you@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Xendit hosted checkout. Keep the secret key and webhook token server-only.
# Local HTTP works for creating a sandbox checkout, but Xendit cannot redirect
# or deliver webhooks to localhost. Use an HTTPS tunnel for full end-to-end tests.
APP_URL=https://localhost:3000

XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=

# Weekly department reports: off until a test-workspace rollout is verified.
WEEKLY_REPORT_EMAILS_ENABLED=false
# Comma-separated workspace IDs; empty permits all workspaces when enabled.
WEEKLY_REPORT_WORKSPACE_IDS=
CRON_SECRET=

# Read-only MCP pilot (.harness/tickr-mcp-read-only): off by default.
MCP_ENABLED=false
# Comma-separated user IDs allowed to connect; empty admits nobody.
MCP_PILOT_USER_IDS=

# Daily reports (docs/email-logics/daily-reports.md): nightly report to each
# member, their department Admins, and Owners, plus a short-hours reminder. Off by
# default; requires RESEND_API_KEY, APP_URL, BETTER_AUTH_SECRET and CRON_SECRET.
DAILY_REPORT_EMAILS_ENABLED=false
# Comma-separated workspace IDs; empty permits all workspaces when enabled.
DAILY_REPORT_WORKSPACE_IDS=
# Shared HR mailbox(es) that also receive the workspace report, comma-separated.
DAILY_REPORT_HR_EMAILS=
# Local hour (1-22) for the end-of-shift reminder Monday-Friday, or "off".
DAILY_REPORT_NUDGE_HOUR=17
# Weekday minimum = workspace expected daily hours minus this allowance.
DAILY_REPORT_BREAK_ALLOWANCE_HOURS=0.5
# Saturday (half day) minimum; 0 makes Saturday a rest day like Sunday.
DAILY_REPORT_SATURDAY_MIN_HOURS=4
# Workspace-local holidays (rest days, never flagged), e.g. 2026-12-25,2026-12-30
DAILY_REPORT_HOLIDAYS=
# Largest PDF (MB) attached to a report email; larger ones are sent as a
# download link only. 0 = always link only.
DAILY_REPORT_ATTACHMENT_MAX_MB=2

MOBILE_SERVER_URL=https://timetrackly.com

# Offline mode (.harness/offline-mode): on unless set to "false".
# OFFLINE_QUEUE_V2_ENABLED=false blocks new offline capture; anything already
# queued on a device still syncs. OFFLINE_CACHE_ENABLED=false stops storing
# data for offline reading and opening. OFFLINE_GRACE_HOURS bounds how long a
# member can open the app offline after their last online session.
OFFLINE_QUEUE_V2_ENABLED=true
OFFLINE_CACHE_ENABLED=true
OFFLINE_GRACE_HOURS=24
