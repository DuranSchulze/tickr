{
  "manifest_version": 3,
  "name": "Trackly",
  "version": "1.0.0",
  "description": "Track time effortlessly from your browser side panel",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://flow-track-theta.vercel.app/*",
    "https://tickr-nu.vercel.app/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Trackly",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
