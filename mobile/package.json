{
  "name": "trackly-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:device": "pnpm sync && node scripts/gradle.mjs connectedDebugAndroidTest",
    "test:restart": "pnpm build:debug && node scripts/gradle.mjs assembleDebugAndroidTest && node scripts/test-restart.mjs",
    "test:signout": "pnpm build:debug && node scripts/gradle.mjs assembleDebugAndroidTest && node scripts/test-restart.mjs --signout",
    "spike:server": "node scripts/spike-server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "sync": "cap sync android",
    "open": "cap open android",
    "build:debug": "pnpm sync && node scripts/gradle.mjs assembleDebug",
    "build:release": "pnpm sync && node scripts/gradle.mjs bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/geolocation": "8.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "typescript": "5.9.3"
  }
}
